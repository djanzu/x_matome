# 取得対象のXユーザーID（@なし）
TARGET_USERNAME=jack

# 送信先
SEND_TO=DISCORD

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# discord 
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx

# 使う LLM プロファイル（llm_profiles.yaml の profiles のキー。省略時は default）
# LLM_PROFILE=suisei2

# LLM の API キー（llm_profiles.yaml の api_key_env で参照する）
VLLM_API_KEY=EMPTY
# OPENAI_API_KEY=sk-...
